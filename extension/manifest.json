{
  "manifest_version": 3,
  "name": "SlotDesk Pilot",
  "version": "0.9.3",
  "minimum_chrome_version": "116",
  "description": "Find meeting times, review every detail, and send Google Calendar invitations.",
  "permissions": [
    "sidePanel",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://slotdesk-leads.vercel.app/*"
  ],
  "action": {
    "default_title": "Open SlotDesk"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "prototype/background.js"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'self' https://www.googleapis.com https://slotdesk-leads.vercel.app; base-uri 'none'"
  },
  "key": "",
  "oauth2": {
    "client_id": "455352053894-vp4fk3rulqvgc3n0v26ftq4k9q24hghr.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
      "https://www.googleapis.com/auth/calendar.events.freebusy"
    ]
  }
}
