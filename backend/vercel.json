{
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/leads.mjs": {
      "maxDuration": 15
    },
    "api/google.mjs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
